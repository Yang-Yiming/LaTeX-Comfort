{
  "name": "latex-comfort-ai",
  "displayName": "LaTeX Comfort AI",
  "description": "AI selection editing for LaTeX Comfort.",
  "version": "0.1.0",
  "publisher": "latex-comfort-dev",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.146.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:latexComfort.ai.editSelection",
    "onCommand:latexComfort.ai.configureProvider",
    "onCommand:latexComfort.ai.runAgent"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "build:webview": "vite build --config webview/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "@latex-comfort/shared": "workspace:*",
    "highlight.js": "~11.11.2",
    "lowlight": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "extensionDependencies": [
    "latex-comfort-dev.latex-comfort"
  ],
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "latex",
    "tex",
    "ai",
    "rewrite",
    "proofread",
    "selection",
    "writing"
  ],
  "contributes": {
    "commands": [
      {
        "command": "latexComfort.ai.editSelection",
        "title": "LaTeX Comfort AI: Edit Selection\u2026",
        "category": "LaTeX Comfort AI"
      },
      {
        "command": "latexComfort.ai.configureProvider",
        "title": "LaTeX Comfort AI: Configure Provider",
        "category": "LaTeX Comfort AI"
      },
      {
        "command": "latexComfort.ai.configureReviewSurface",
        "title": "LaTeX Comfort AI: Configure Review Surface",
        "category": "LaTeX Comfort AI"
      },
      {
        "command": "latexComfort.ai.runAgent",
        "title": "LaTeX Comfort AI: Run Agent",
        "category": "LaTeX Comfort AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "latexComfort.ai.editSelection",
          "when": "editorHasSelection && !editorReadonly && editorTextFocus",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "latexComfort.ai.editSelection"
        },
        {
          "command": "latexComfort.ai.configureProvider"
        },
        {
          "command": "latexComfort.ai.configureReviewSurface"
        },
        {
          "command": "latexComfort.ai.runAgent"
        }
      ]
    },
    "keybindings": [
      {
        "command": "latexComfort.ai.editSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection && !editorReadonly && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "LaTeX Comfort AI",
      "properties": {
        "latexComfort.ai.provider": {
          "type": "string",
          "enum": [
            "vscode-lm",
            "openai-compatible",
            "deepseek",
            "opencode-go"
          ],
          "default": "vscode-lm",
          "description": "Provider used for selection edits."
        },
        "latexComfort.ai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible base URL, without /chat/completions."
        },
        "latexComfort.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model name. Provider presets use their own defaults when empty. For vscode-lm this can be a model id or family."
        },
        "latexComfort.ai.maxChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1,
          "description": "Maximum selected characters for one AI edit."
        },
        "latexComfort.ai.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature for OpenAI-compatible providers."
        },
        "latexComfort.ai.review.presentation": {
          "type": "string",
          "enum": [
            "auto",
            "inline",
            "sidePanel"
          ],
          "default": "auto",
          "order": 10,
          "enumDescriptions": [
            "Choose automatically: inline for short selections and the side panel for long reviews.",
            "Stable decoration + CodeLens review directly in the editor.",
            "Show the full review card beside the editor. Best for long selections."
          ],
          "markdownDescription": "Where to review AI edits. Run **LaTeX Comfort AI: Configure Review Surface** from the Command Palette for a guided picker.\n\n`auto` keeps short selections inline and opens long reviews beside the editor."
        },
        "latexComfort.ai.agent.opencodePath": {
          "type": "string",
          "default": "opencode",
          "description": "OpenCode executable used for ACP agent runs. OpenCode 2 exposes the same `opencode acp` command."
        },
        "latexComfort.ai.agent.codexAcpPath": {
          "type": "string",
          "default": "codex-acp",
          "description": "Codex ACP bridge executable. Install it with `npm install -g @agentclientprotocol/codex-acp` if it is not on PATH."
        },
        "latexComfort.ai.agent.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Codex CLI executable passed to the ACP bridge through CODEX_PATH."
        }
      }
    }
  }
}
