{
  "name": "latex-comfort",
  "displayName": "LaTeX Comfort",
  "description": "Quality-of-life improvements for LaTeX writing in VS Code.",
  "version": "0.1.0",
  "publisher": "latex-comfort-dev",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.146.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:latexComfort.showCompileProblems",
    "onCommand:latexComfort.toggleBold",
    "onCommand:latexComfort.toggleEmphasis",
    "onCommand:latexComfort.toggleUnderline",
    "onCommand:latexComfort.toggleInlineMath",
    "onCommand:latexComfort.toggleDisplayMath",
    "onCommand:latexComfort.toggleEquation",
    "onCommand:latexComfort.toggleItemize",
    "onCommand:latexComfort.toggleEnumerate",
    "onCommand:latexComfort.toggleQuote",
    "onCommand:latexComfort.toggleComment",
    "onCommand:latexComfort.toggleIffalse",
    "onCommand:latexComfort.insertSymbol",
    "onCommand:latexComfort.nextCompileProblem",
    "onCommand:latexComfort.previousCompileProblem",
    "onLanguage:latex",
    "onLanguage:markdown",
    "onView:latexComfort.papers"
  ],
  "contributes": {
    "commands": [
      {
        "command": "latexComfort.showCompileProblems",
        "title": "Show Compile Problems",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleBold",
        "title": "Toggle Bold",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleEmphasis",
        "title": "Toggle Emphasis",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleUnderline",
        "title": "Toggle Underline",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleInlineMath",
        "title": "Toggle Inline Math",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleDisplayMath",
        "title": "Toggle Display Math",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleEquation",
        "title": "Toggle Equation Environment",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleItemize",
        "title": "Toggle Itemize Environment",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleEnumerate",
        "title": "Toggle Enumerate Environment",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleQuote",
        "title": "Toggle Quote Environment",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleComment",
        "title": "Toggle Comment Environment",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.toggleIffalse",
        "title": "Toggle \\iffalse Block",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.insertSymbol",
        "title": "Insert Math Symbol\u2026",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.nextCompileProblem",
        "title": "Next Compile Problem",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.previousCompileProblem",
        "title": "Previous Compile Problem",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.papers.add",
        "title": "Add Paper\u2026",
        "category": "LaTeX Comfort",
        "icon": "$(add)"
      },
      {
        "command": "latexComfort.papers.refresh",
        "title": "Refresh Papers",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.papers.search",
        "title": "Search Papers",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.papers.insertCitation",
        "title": "Insert Citation",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.papers.openEntry",
        "title": "Open Bibliography Entry",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.papers.copyKey",
        "title": "Copy Citation Key",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.papers.openLink",
        "title": "Open Paper Link",
        "category": "LaTeX Comfort"
      },
      {
        "command": "latexComfort.papers.selectBibliography",
        "title": "Select Bibliography",
        "category": "LaTeX Comfort",
        "icon": "$(folder-opened)"
      },
      {
        "command": "latexComfort.papers.filter",
        "title": "Filter Papers",
        "category": "LaTeX Comfort",
        "icon": "$(filter)"
      }
    ],
    "keybindings": [
      {
        "command": "latexComfort.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && !editorReadOnly && editorHasSelection && editorLangId =~ /^(latex|tex|latex-expl3)$/ && config.latexComfort.keybindings.boldOnSelection"
      },
      {
        "command": "latexComfort.toggleEmphasis",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadOnly && editorHasSelection && editorLangId =~ /^(latex|tex|latex-expl3)$/ && config.latexComfort.keybindings.emphasisOnSelection"
      }
    ],
    "snippets": [
      {
        "language": "latex",
        "path": "./snippets/latex.json"
      },
      {
        "language": "tex",
        "path": "./snippets/latex.json"
      }
    ],
    "submenus": [
      {
        "id": "latexComfort.actions",
        "label": "LaTeX Comfort"
      }
    ],
    "configuration": {
      "title": "LaTeX Comfort",
      "properties": {
        "latexComfort.papers.bibliographyPath": {
          "type": "string",
          "default": "",
          "description": "Workspace-folder-relative path to the bibliography used by the Papers view. Leave empty to detect it from LaTeX source or the only .bib file."
        },
        "latexComfort.papers.contactEmail": {
          "type": "string",
          "default": "",
          "description": "Optional contact email sent to Crossref and arXiv APIs for polite API usage."
        },
        "latexComfort.keybindings.boldOnSelection": {
          "type": "boolean",
          "default": true,
          "description": "Use Cmd+B / Ctrl+B to toggle \\textbf on a LaTeX selection. With no selection, the key keeps its normal VS Code action."
        },
        "latexComfort.keybindings.emphasisOnSelection": {
          "type": "boolean",
          "default": true,
          "description": "Use Cmd+I / Ctrl+I to toggle \\emph or \\textit on a LaTeX selection. With no selection, the key keeps its normal VS Code action."
        },
        "latexComfort.status.wordCount.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the live word count for the active LaTeX file or selection."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "latexComfort.papers",
          "name": "Papers",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "latexComfort.papers",
        "contents": "No project bibliography found. [Select Bibliography](command:latexComfort.papers.selectBibliography)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "latexComfort.actions",
          "when": "editorLangId =~ /^(latex|tex|latex-expl3)$/",
          "group": "navigation@90"
        }
      ],
      "latexComfort.actions": [
        {
          "command": "latexComfort.toggleBold",
          "when": "editorHasSelection",
          "group": "1_format@1"
        },
        {
          "command": "latexComfort.toggleEmphasis",
          "when": "editorHasSelection",
          "group": "1_format@2"
        },
        {
          "command": "latexComfort.toggleUnderline",
          "when": "editorHasSelection",
          "group": "1_format@3"
        },
        {
          "command": "latexComfort.toggleInlineMath",
          "group": "2_math@1"
        },
        {
          "command": "latexComfort.toggleDisplayMath",
          "group": "2_math@2"
        },
        {
          "command": "latexComfort.insertSymbol",
          "group": "2_math@3"
        },
        {
          "command": "latexComfort.toggleEquation",
          "group": "3_environment@1"
        },
        {
          "command": "latexComfort.toggleItemize",
          "group": "3_environment@2"
        },
        {
          "command": "latexComfort.toggleEnumerate",
          "group": "3_environment@3"
        },
        {
          "command": "latexComfort.toggleQuote",
          "group": "3_environment@4"
        },
        {
          "command": "latexComfort.toggleComment",
          "group": "3_environment@5"
        },
        {
          "command": "latexComfort.toggleIffalse",
          "group": "4_comment@1"
        }
      ],
      "view/title": [
        {
          "command": "latexComfort.papers.add",
          "when": "view == latexComfort.papers",
          "group": "navigation@1"
        },
        {
          "command": "latexComfort.papers.filter",
          "when": "view == latexComfort.papers",
          "group": "navigation@2"
        },
        {
          "command": "latexComfort.papers.search",
          "when": "view == latexComfort.papers",
          "group": "navigation@3"
        },
        {
          "command": "latexComfort.papers.selectBibliography",
          "when": "view == latexComfort.papers",
          "group": "navigation@4"
        },
        {
          "command": "latexComfort.papers.refresh",
          "when": "view == latexComfort.papers",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "latexComfort.papers.insertCitation",
          "when": "view == latexComfort.papers && viewItem == paper",
          "group": "inline@1"
        },
        {
          "command": "latexComfort.papers.openEntry",
          "when": "view == latexComfort.papers && viewItem == paper",
          "group": "navigation@1"
        },
        {
          "command": "latexComfort.papers.copyKey",
          "when": "view == latexComfort.papers && viewItem == paper",
          "group": "navigation@2"
        },
        {
          "command": "latexComfort.papers.openLink",
          "when": "view == latexComfort.papers && viewItem == paper",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "latexComfort.papers.add"
        },
        {
          "command": "latexComfort.papers.filter"
        },
        {
          "command": "latexComfort.papers.refresh"
        },
        {
          "command": "latexComfort.papers.search"
        },
        {
          "command": "latexComfort.papers.insertCitation"
        },
        {
          "command": "latexComfort.papers.openEntry"
        },
        {
          "command": "latexComfort.papers.copyKey"
        },
        {
          "command": "latexComfort.papers.openLink"
        },
        {
          "command": "latexComfort.papers.selectBibliography"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@latex-comfort/shared": "workspace:*"
  }
}
