{
  "name": "latex-comfort-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build && pnpm --filter latex-comfort-ai build:webview",
    "build:core": "pnpm --filter latex-comfort build",
    "build:ai": "pnpm --filter latex-comfort-ai build",
    "build:webview": "pnpm --filter latex-comfort-ai build:webview",
    "build:stable": "pnpm --filter latex-comfort-ai build && pnpm --filter latex-comfort-ai build:webview",
    "build:experimental": "pnpm --filter latex-comfort-ai-experimental build",
    "package:stable": "pnpm build:stable && cd packages/latex-comfort-ai && npx --yes @vscode/vsce@latest package --no-dependencies --allow-missing-repository -o latex-comfort-ai-0.1.0.vsix",
    "package:experimental": "pnpm --filter latex-comfort-ai-experimental package"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.146.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
